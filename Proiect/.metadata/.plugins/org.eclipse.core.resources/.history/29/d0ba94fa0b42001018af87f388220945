#include "MotorControl.h"

extern TIM_HandleTypeDef htim1;
extern TIM_HandleTypeDef htim3;

extern int8_t zeroLearned;
extern wheelReport reportContainer;

extern uint16_t adc1_dma_val;
extern uint16_t adc2_dma_val;

#define PI_F 3.1415926f
#define FOC_LOOP_FREQ_HZ 20000.0f
#define MAX_CURRENT_ADC 200.0f
#define MAX_VOLTAGE     12.0f
#define CLAMP(x, lo, hi) ((x) < (lo) ? (lo) : ((x) > (hi) ? (hi) : (x)))
#define ENC_COUNTS_PER_REV (4096 * 4)
#define POLE_PAIRS 15
#define MAX_TORQUE_CURRENT 0.5f

#define ALIGN_MAGNITUDE 0.3f  // volts applied to d-axis (can be tuned)
#define ALIGN_TIME_MS 10000  // time to hold the rotor in place

static int16_t electrical_zero_count = 0;

// Persistent offsets for ADC baseline calibration
static int32_t C0 = 0;
static int32_t C1 = 0;

// Phase currents
static int32_t c0 = 0, c1 = 0, c2 = 0;
static int32_t C = 0;

// FOC state
static float id = 0, iq = 0;
static float id_integral = 0, iq_integral = 0;
static float vd = 0, vq = 0;
static float valpha = 0, vbeta = 0;
static float va = 0, vb = 0, vc = 0;
static float iq_target = 0;
static float ph = 0;

int16_t force = 0;

static float kp = 0.002f;
static float ki = 0.0001f;

void AlignElectricalZero()
{
    float sin_t = 0.0f;
    float cos_t = 1.0f;  // d-axis = 0 rad

    // Apply scaled voltage vector
    float valpha = ALIGN_MAGNITUDE * MAX_VOLTAGE * cos_t;
    float vbeta  = ALIGN_MAGNITUDE * MAX_VOLTAGE * sin_t;

    float va = valpha;
    float vb = -0.5f * valpha + sqrtf(3.0f)/2.0f * vbeta;
    float vc = -0.5f * valpha - sqrtf(3.0f)/2.0f * vbeta;

    float period = (float)htim1.Init.Period;
    float dutyA = (0.5f + 0.5f * va / MAX_VOLTAGE) * period;
    float dutyB = (0.5f + 0.5f * vb / MAX_VOLTAGE) * period;
    float dutyC = (0.5f + 0.5f * vc / MAX_VOLTAGE) * period;

    dutyA = CLAMP(dutyA, 0, period);
    dutyB = CLAMP(dutyB, 0, period);
    dutyC = CLAMP(dutyC, 0, period);

    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyB);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyC);

    HAL_Delay(ALIGN_TIME_MS);  // let the motor settle

    electrical_zero_count = (int16_t)__HAL_TIM_GET_COUNTER(&htim3);
}

void SetupMotor()
{
    // Start PWM channels
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);

    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_3);

    while(!zeroLearned);
    AlignElectricalZero();

    // Set initial PWM to 0
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, 0);

    HAL_Delay(10);

    // ADC zero offset calibration
    for (int i = 0; i < 256; i++)
    {
        C0 += adc1_dma_val;
        HAL_Delay(2);
        C1 += adc2_dma_val;
        HAL_Delay(2);
    }
    C0 >>= 8;
    C1 >>= 8;

    HAL_TIM_Base_Start_IT(&htim1);
}

void MotorControl(void)
{
    // --- Current sensing ---
    c0 = adc1_dma_val - C0;
    c1 = adc2_dma_val - C1;
    c2 = -(c0 + c1);

    // --- Electrical angle from encoder ---
    int16_t enc = (int16_t)__HAL_TIM_GET_COUNTER(&htim3);
    int16_t offset_enc = enc - electrical_zero_count;
    ph = -offset_enc * (2.0f * PI_F * POLE_PAIRS / ENC_COUNTS_PER_REV);

    float sin_t = sinf(ph);
    float cos_t = cosf(ph);

    // --- Clarke Transform ---
    float is_alpha = c0;
    float is_beta  = (c0 + 2.0f * c1) / sqrtf(3.0f);

    // --- Park Transform ---
    id = cos_t * is_alpha + sin_t * is_beta;
    iq = -sin_t * is_alpha + cos_t * is_beta;

    // --- Targets (iq_target to be set from force feedback) ---
    float id_target = 0.0f;

    force = 0;  // raw output from FFB system
    //iq_target = (float)force / 32767.0f * MAX_TORQUE_CURRENT;
    iq_target = 0.2f;


    // --- PI Controllers ---
    vd = PI_Controller(id_target - id, &id_integral, kp, ki, MAX_VOLTAGE);
    vq = PI_Controller(iq_target - iq, &iq_integral, kp, ki, MAX_VOLTAGE);

    vd = CLAMP(vd, -3.0f, 3.0f);
    vq = CLAMP(vq, -3.0f, 3.0f);


    // --- Inverse Park Transform ---
    valpha = vd * cos_t - vq * sin_t;
    vbeta  = vd * sin_t + vq * cos_t;

    // --- αβ → abc conversion ---
    va = valpha;
    vb = -0.5f * valpha + (sqrtf(3.0f) / 2.0f) * vbeta;
    vc = -0.5f * valpha - (sqrtf(3.0f) / 2.0f) * vbeta;

    // --- Normalize to PWM duty ---
    float period = (float)htim1.Init.Period;
    float dutyA = (0.5f + 0.5f * va / MAX_VOLTAGE) * period;
    float dutyB = (0.5f + 0.5f * vb / MAX_VOLTAGE) * period;
    float dutyC = (0.5f + 0.5f * vc / MAX_VOLTAGE) * period;

    // Clamp to valid range
    dutyA = CLAMP(dutyA, 0, period);
    dutyB = CLAMP(dutyB, 0, period);
    dutyC = CLAMP(dutyC, 0, period);

    // --- Basic overcurrent protection ---
    C = sqrtf(c0 * c0 + c1 * c1 + c2 * c2);
    if (C > MAX_CURRENT_ADC) {
        dutyA *= 0.9f;
        dutyB *= 0.9f;
        dutyC *= 0.9f;
    }

    // --- Apply PWM ---
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyB);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyC);

    // --- Optional reporting ---
    reportContainer.Z = C;
    reportContainer.Dial = c0;
    reportContainer.Slider = c1;
}

float PI_Controller(float error, float* integral, float kp, float ki, float limit)
{
    *integral += ki * error;
    float output = kp * error + *integral;

    // Clamp output and anti-windup
    if (output > limit) {
        output = limit;
        if (*integral > limit) *integral = limit;
    } else if (output < -limit) {
        output = -limit;
        if (*integral < -limit) *integral = -limit;
    }

    return output;
}
