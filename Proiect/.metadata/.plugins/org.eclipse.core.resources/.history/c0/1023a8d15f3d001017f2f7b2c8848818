#include <Wheel.h>

volatile int16_t encoder;
static int16_t offset_encoder=0;
extern TIM_HandleTypeDef htim3;

extern wheelReport reportContainer;

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
	encoder = __HAL_TIM_GET_COUNTER(htim);
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
	if(GPIO_Pin == ENC_Z_Pin)
	{
		offset_encoder = encoder;
		if(offset_encoder > 0)
			encoder -= offset_encoder;
		else
			encoder += offset_encoder;
		__HAL_TIM_SET_COUNTER(&htim3, 0); // Resetam timer-ul la 0
		EXTI->IMR &= ~(1 << 9);  // Dezactivam intreruperea doar pe linia 9
	}
}

void StartEncoder()
{
	HAL_TIM_Encoder_Start_IT(&htim3, TIM_CHANNEL_ALL);
}

void UpdateWheel()
{
	reportContainer.X = encoder;
}
