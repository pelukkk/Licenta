#include "Pedals.h"

extern ADC_HandleTypeDef hadc1;
extern ADC_HandleTypeDef hadc2;
extern ADC_HandleTypeDef hadc3;

uint16_t clutchBuffer[FILTER_SIZE] = {0};
uint8_t clutchIndex = 0;
uint16_t rawClutch = 0;
uint16_t clutch = 0;

uint16_t brakeBuffer[FILTER_SIZE] = {0};
uint8_t brakeIndex = 0;
uint16_t rawBrake = 0;
uint16_t brake = 0;;

uint16_t throttleBuffer[FILTER_SIZE] = {0};
uint8_t throttleIndex = 0;
uint16_t rawThrottle = 0;
uint16_t throttle = 0;

uint16_t FilterADC(uint16_t *buffer, uint8_t *index, uint16_t newSample)
{
    buffer[*index] = newSample;
    *index = (*index + 1) % FILTER_SIZE;

    uint32_t sum = 0;
    for (int i = 0; i < FILTER_SIZE; i++) {
        sum += buffer[i];
    }

    return sum / FILTER_SIZE;
}

void UpdatePedals()
{
	// Read clutch from ADC1
	HAL_ADC_Start(&hadc1);
	HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
	rawClutch = HAL_ADC_GetValue(&hadc1);
	clutch = FilterADC(clutchBuffer, &clutchIndex, rawClutch);

	// Read brake from ADC2
	HAL_ADC_Start(&hadc2);
	HAL_ADC_PollForConversion(&hadc2, HAL_MAX_DELAY);
	rawBrake = HAL_ADC_GetValue(&hadc2);
	brake = FilterADC(brakeBuffer, &brakeIndex, rawBrake);

	// Read throttle from ADC3
	HAL_ADC_Start(&hadc3);
	HAL_ADC_PollForConversion(&hadc3, HAL_MAX_DELAY);
	rawThrottle = HAL_ADC_GetValue(&hadc3);
	throttle = FilterADC(throttleBuffer, &throttleIndex, rawThrottle);
}
