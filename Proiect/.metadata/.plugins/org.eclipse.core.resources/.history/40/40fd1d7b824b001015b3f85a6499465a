#include "MotorControl.h"

extern TIM_HandleTypeDef htim1;
extern TIM_HandleTypeDef htim3;

extern ADC_HandleTypeDef hadc1;
extern ADC_HandleTypeDef hadc2;

extern int8_t zeroLearned;
extern wheelReport reportContainer;
extern FFB_Effect effects[MAX_EFFECTS];
extern bool ffb_active;

#define MAX_VOLTAGE     12.0f
#define CLAMP(x, lo, hi) ((x) < (lo) ? (lo) : ((x) > (hi) ? (hi) : (x)))
#define ENC_COUNTS_PER_REV (4096 * 4)
#define POLE_PAIRS 15

#define ALIGN_MAGNITUDE 0.2f
#define ALIGN_TIME_MS 2000  // time to hold the rotor in place

// Motor speed and acceleration variables

int16_t speed = 0;
int16_t accel = 0;
int16_t pos = 0;

static int16_t electrical_zero_count = 0;

// Persistent offsets for ADC baseline calibration
static int32_t Ib_adc0 = 0;
static int32_t Ic_adc0 = 0;

// Phase currents
static int16_t Ib_adc = 0;
static int16_t Ic_adc = 0;
static int32_t Ib = 0, Ic = 0, Ia = 0;
static int32_t I = 0;

// FOC state
static float id = 0, iq = 0;
static float id_integral = 0, iq_integral = 0;
static float vd = 0, vd0 = 0, vq = 0, vq0=0;
static float valpha = 0, vbeta = 0;
static float va = 0, vb = 0, vc = 0;
static float iq_target = 0;
static float ph = 0;

int16_t force = 0;

static float kp = 0.001f;
static float ki = 0.0002f;


void AlignElectricalZero()
{
    float sin_t = 0.0f;
    float cos_t = 1.0f;  // d-axis alignment

    float period = (float)htim1.Init.Period;
    uint32_t ramp_time_ms = ALIGN_TIME_MS;   // total align time
    uint32_t step_delay_ms = 5;              // time per step
    uint32_t steps = ramp_time_ms / step_delay_ms;

    for (uint32_t i = 0; i < steps; i++)
    {
        float ramp = (float)i / (float)steps;         // from 0.0 to 1.0
        float align_mag = ramp * ALIGN_MAGNITUDE;                // final magnitude target

        float valpha = align_mag * MAX_VOLTAGE * cos_t;
        float vbeta  = align_mag * MAX_VOLTAGE * sin_t;

        float va = valpha;
        float vb = -0.5f * valpha + sqrtf(3.0f)/2.0f * vbeta;
        float vc = -0.5f * valpha - sqrtf(3.0f)/2.0f * vbeta;

        float dutyA = (0.5f + 0.5f * va / MAX_VOLTAGE) * period;
        float dutyB = (0.5f + 0.5f * vb / MAX_VOLTAGE) * period;
        float dutyC = (0.5f + 0.5f * vc / MAX_VOLTAGE) * period;

        dutyA = CLAMP(dutyA, 0, period);
        dutyB = CLAMP(dutyB, 0, period);
        dutyC = CLAMP(dutyC, 0, period);

        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA);
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyC);
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyB);

        HAL_Delay(step_delay_ms);
    }

    HAL_Delay(2000);

    electrical_zero_count = (int16_t)__HAL_TIM_GET_COUNTER(&htim3);
}


void SetupMotor()
{
    // Start PWM channels
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);

    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_3);

    while(!zeroLearned);
    AlignElectricalZero();

    // Set initial PWM to 0
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, 0);

    HAL_Delay(10);

    // ADC zero offset calibration
    for (int i = 0; i < 256; i++)
    {
        Ib_adc0 += HAL_ADCEx_InjectedGetValue(&hadc1, ADC_INJECTED_RANK_1);

        HAL_Delay(2);

        Ic_adc0 += HAL_ADCEx_InjectedGetValue(&hadc2, ADC_INJECTED_RANK_1);

        HAL_Delay(2);
    }

    Ib_adc0 >>= 8;
    Ic_adc0 >>= 8;

    HAL_TIM_Base_Start_IT(&htim1);
}

void MotorControl(void)
{
    // --- Current sensing ---
	Ib_adc = HAL_ADCEx_InjectedGetValue(&hadc1, ADC_INJECTED_RANK_1);
	Ic_adc = HAL_ADCEx_InjectedGetValue(&hadc2, ADC_INJECTED_RANK_1);

    Ib = Ib_adc - Ib_adc0;
    Ic = Ic_adc - Ic_adc0;
    Ia = -(Ib + Ic);

    // --- Electrical angle from encoder ---
    pos = (int16_t)__HAL_TIM_GET_COUNTER(&htim3);
    int16_t offset_enc = pos - electrical_zero_count;
    ph = offset_enc * (2.0f * PI_F * POLE_PAIRS / ENC_COUNTS_PER_REV);

    float sin_t = sinf(ph);
    float cos_t = cosf(ph);

    // --- Clarke Transform ---
    float is_alpha = Ia;
    float is_beta  = (Ia + 2.0f * Ic) / sqrtf(3.0f);

    // --- Park Transform ---
    id = cos_t * is_alpha + sin_t * is_beta;
    iq = -sin_t * is_alpha + cos_t * is_beta;

    // --- Targets (iq_target to be set from force feedback) ---
    float id_target = 0.0f;

    //iq_target = 0.0f;

    float iq_target0 = calculateWheelForce(pos, speed, accel);

    float dx = max(0, abs(pos) - 20480);

    if(dx > 1) iq_target0 = 10*dx*(pos<0 ? -1 : 1);

    //if(pos < -20480) iq_target0 = (pos + 20480);
    //else if (pos > 20480) iq_target0 = (pos - 20480);

    iq_target = CLAMP(iq_target0, -300, 300);

    // --- PI Controllers ---
    vd0 = PI_Controller(id-id_target, &id_integral, kp, ki, MAX_VOLTAGE);
    vq0 = PI_Controller(iq-iq_target, &iq_integral, kp, ki, MAX_VOLTAGE);

    vd = CLAMP(vd0, -1.0f, 1.0f);
    vq = CLAMP(vq0, -6.0f, 6.0f);


    // --- Inverse Park Transform ---
    valpha = vd * cos_t - vq * sin_t;
    vbeta  = vd * sin_t + vq * cos_t;

    // --- αβ → abc conversion ---
    va = valpha;
    vb = -0.5f * valpha + (sqrtf(3.0f) / 2.0f) * vbeta;
    vc = -0.5f * valpha - (sqrtf(3.0f) / 2.0f) * vbeta;

    // --- Normalize to PWM duty ---
    float period = (float)htim1.Init.Period;
    float dutyA = (0.5f + 0.5f * va / MAX_VOLTAGE) * period;
    float dutyB = (0.5f + 0.5f * vb / MAX_VOLTAGE) * period;
    float dutyC = (0.5f + 0.5f * vc / MAX_VOLTAGE) * period;

    // Clamp to valid range
    dutyA = CLAMP(dutyA, 0, period);
    dutyB = CLAMP(dutyB, 0, period);
    dutyC = CLAMP(dutyC, 0, period);

    // --- Basic overcurrent protection ---
    I = sqrtf(Ib * Ib + Ic * Ic + Ia * Ia);

    // --- Apply PWM ---
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyC);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyB);

    // --- Optional reporting ---
    reportContainer.Z = I;
    reportContainer.Dial = id*vd + iq*vq;
    reportContainer.Slider = Ic;
}

float PI_Controller(float error, float* integral, float kp, float ki, float limit)
{
    *integral += ki * error;
    float output = kp * error + *integral;

    return output;
}
