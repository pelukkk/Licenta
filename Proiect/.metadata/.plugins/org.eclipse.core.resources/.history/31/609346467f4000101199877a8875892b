#include "DRV8301.h"
#include "delay.h"

extern SPI_HandleTypeDef hspi3;

static inline uint16_t drv8301_build_ctrl_word(uint8_t rw, uint8_t address, uint16_t data) {
    return ((rw & 0x1) << 15) | ((address & 0xF) << 11) | (data & 0x7FF);
}

void drv8301_init()
{
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_SET);
}

bool drv8301_write_reg(uint8_t reg, uint16_t data)
{
    uint16_t tx = drv8301_build_ctrl_word(DRV8301_CTRL_MODE_WRITE, reg, data);
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_RESET);
    bool ok = HAL_SPI_Transmit(&hspi3, (uint8_t*)&tx, 1, DRV8301_SPI_TIMEOUT) == HAL_OK;
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_SET);
    delay_us(1);
    return ok;
}

bool drv8301_read_reg(uint8_t reg, uint16_t *data) {
    uint16_t tx = drv8301_build_ctrl_word(DRV8301_CTRL_MODE_READ, reg, 0);
    uint16_t rx = 0xFFFF;

    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi3, (uint8_t*)&tx, 1, DRV8301_SPI_TIMEOUT);
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_SET);
    delay_us(1);

    tx = drv8301_build_ctrl_word(DRV8301_CTRL_MODE_READ, reg, 0);
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_RESET);
    bool ok = HAL_SPI_TransmitReceive(&hspi3, (uint8_t*)&tx, (uint8_t*)&rx, 1, DRV8301_SPI_TIMEOUT) == HAL_OK;
    HAL_GPIO_WritePin(DRV8301_NCS_GPIO_Port, DRV8301_NCS_Pin, GPIO_PIN_SET);

    if (rx == 0xBEEF) return false;
    if (data) *data = rx & 0x07FF;
    return ok;
}
